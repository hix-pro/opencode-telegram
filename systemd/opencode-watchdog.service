[Unit]
Description=Staleness watchdog for opencode-telegram-bridge
# The bridge's `Restart=always` covers crashes; this oneshot covers a poll
# thread that hangs while systemd still calls the unit "active". Bridge code
# touches the heartbeat every poll iteration, so mere Telegram outages stay
# invisible to it.

[Service]
Type=oneshot
# Working dir is the space-free alias (/home/demo/opencode-bridge == the real
# directory, which contains a space). Set WATCHDOG_ALERT_URL in the bridge's
# .env to push an alert through a webhook before the restart; unset means
# restart silently.
EnvironmentFile=-/home/demo/opencode-bridge/.env
ExecStart=/usr/bin/python3 /home/demo/opencode-bridge/scripts/heartbeat_watchdog.py /home/demo/opencode-bridge/.bridge-heartbeat --max-age 180
