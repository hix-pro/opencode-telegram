[Unit]
Description=OpenCode Telegram Bridge
Documentation=https://opencode.ai/v2/docs/
After=network-online.target opencode-server.service
Wants=network-online.target
Requires=opencode-server.service

[Service]
Type=simple
# Path uses a symlink because systemd cannot handle the space in the real
# directory name ("the project directory"). Files live in the Desktop folder.
WorkingDirectory=/home/demo/opencode-bridge
EnvironmentFile=/home/demo/opencode-bridge/.env
ExecStart=/usr/bin/python3 /home/demo/opencode-bridge/bridge.py
Restart=always
RestartSec=10
# Long enough for the SIGTERM handler to exit cleanly rather than be SIGKILLed
# mid-turn, which would orphan the turn.
TimeoutStopSec=30

[Install]
WantedBy=default.target