[Unit]
Description=OpenCode Telegram Bridge
Documentation=https://opencode.ai/v2/docs/
After=network-online.target
Wants=network-online.target opencode-server.service

[Service]
Type=simple
# Generated by install.sh from this template
# (systemd/opencode-telegram-bridge.service.in). WorkingDirectory and
# EnvironmentFile cannot be quoted in systemd, so install.sh renders them as
# raw paths and creates a space-free alias symlink when the checkout itself
# has spaces. If the checkout moves, re-run install.sh instead of editing
# the installed copy.
WorkingDirectory=@REPO@
EnvironmentFile=@REPO@/.env
ExecStart="@PYTHON@" "@REPO@/bridge.py"
Restart=always
RestartSec=10
# Long enough for the SIGTERM handler to exit cleanly rather than be SIGKILLed
# mid-turn, which would orphan the turn.
TimeoutStopSec=30

# --- sandbox ---------------------------------------------------------------
# The bridge is a remote shell. Application checks decide *who* may act; these
# directives limit what a compromised bridge process can touch: no new
# privileges, kernel surfaces locked, private temp, no capabilities and a
# service-typical syscall and socket whitelist (AF_NETLINK included, the set
# already running on the server unit).
#
# The filesystem boundary is NOT rendered here: `bash install.sh
# --harden-bridge` writes a drop-in that turns on ProtectSystem=strict +
# ProtectHome=read-only and grants write access only to this repo directory
# (state, logs, heartbeat, attachments) and never to ALLOWED_ROOTS. Without
# that flag the process-level half above still applies.
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
