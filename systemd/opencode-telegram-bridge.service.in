[Unit]
Description=OpenCode Telegram Bridge
Documentation=https://opencode.ai/v2/docs/
After=network-online.target
Wants=network-online.target opencode-server.service

[Service]
Type=simple
# Generated by install.sh from this template
# (systemd/opencode-telegram-bridge.service.in). WorkingDirectory and
# EnvironmentFile cannot be quoted in systemd, so install.sh renders them as
# raw paths and creates a space-free alias symlink when the checkout itself
# has spaces. If the checkout moves, re-run install.sh instead of editing
# the installed copy.
WorkingDirectory=@REPO@
EnvironmentFile=@REPO@/.env
ExecStart="@PYTHON@" "@REPO@/bridge.py"
Restart=always
RestartSec=10
# Long enough for the SIGTERM handler to exit cleanly rather than be SIGKILLed
# mid-turn, which would orphan the turn.
TimeoutStopSec=30

[Install]
WantedBy=default.target
