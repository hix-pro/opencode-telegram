[Unit]
Description=Staleness watchdog for opencode-telegram-bridge
# Generated by install.sh from this template. The bridge's `Restart=always`
# covers crashes; this oneshot covers a poll thread that hangs while systemd
# still calls the unit "active". Bridge code touches the heartbeat before
# every poll iteration, so mere Telegram outages stay invisible to it.

[Service]
Type=oneshot
# Set WATCHDOG_ALERT_URL in the bridge's .env to push an alert through a
# webhook before the restart; unset means restart silently.
EnvironmentFile=-@REPO@/.env
ExecStart="@PYTHON@" "@REPO@/scripts/heartbeat_watchdog.py" "@REPO@/.bridge-heartbeat" --max-age 180
