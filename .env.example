# Copy to .env, fill in, then: chmod 600 .env. Never commit .env.
#
# Required
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. The built-in default is noted on each line; uncommenting a line
# with a path changes it. Relative paths are resolved from the process cwd.

# --- Connection -------------------------------------------------------------
# OPENCODE_URL=http://127.0.0.1:49374
# PROJECT_DIR=~                        # example; default: directory bridge.py starts in
# STATE_FILE=~/.opencode-bridge/.state.json  # default: .state.json in the checkout
# PROMPT_TIMEOUT=7200     # hard cap on one turn, in seconds (2h)
# HEADS_UP_AFTER=240      # "still working" nudge after this many seconds (4m)
# PROMPT_DELIVERY=queue   # queue holds messages during a turn; inline blocks

# OPENCODE_PASSWORD: read from ~/.config/opencode/service.json when unset.

# --- Live streaming ---------------------------------------------------------
# STREAM_ENABLED=true      # false falls back to send-when-done only
# EDIT_INTERVAL=2.0        # seconds between edits of the live message
# POLL_MESSAGES=2.0        # how often tool activity is refreshed

# Editing a sent user message can queue its new text as another prompt.
# Off by default: an accidental edit must not repeat a side effect.
# EDIT_RESEND=false

# --- Permissions ------------------------------------------------------------
# APPROVAL_MODE=ask        # ask | read (auto-approve reads) | all
# AUTO_DENY=true           # keep the destructive-command deny-list
# PERMISSION_POLL_INTERVAL=5.0

# --- Guard rails ------------------------------------------------------------
# ATTACHMENT_MAX_AGE_HOURS=24   # cached photos/files older than this are deleted
# COST_ALERT=0.0           # warn when a session passes this many dollars
# MAX_OUTPUT=3500          # characters per reply
# MAX_CHUNK=4096           # Telegram's own hard limit

# --- Logging ----------------------------------------------------------------
# LOG_FILE=~/.opencode-bridge/bridge.log  # default: bridge.log in the checkout
# LOG_MAX_BYTES=2097152   # 2 MB per file
# LOG_BACKUPS=3           # keep bridge.log.1 .. .3
#
# Characters of each message you send that are written to the log.
# 0 logs none.
# LOG_PROMPT_CHARS=0

# --- Voice notes ------------------------------------------------------------
# Any command that reads an audio file and prints a transcript. {file} is
# replaced with the downloaded path.
# STT_COMMAND=whisper -m base {file}

# --- Scope ------------------------------------------------------------------
# Comma-separated directories sessions may target. Leave empty to mirror
# `opencode <directory>` in a terminal, i.e. anywhere on this machine.
# Set it to confine the bridge.
# ALLOWED_ROOTS=~